<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#2c2c30"
    android:padding="20dp">

    <!-- Script name -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Name"
        android:textColor="#aaa"
        android:textSize="12sp"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etScriptName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="My Script"
        android:textColor="#ffffff"
        android:textColorHint="#555"
        android:textSize="15sp"
        android:background="#3a3a3e"
        android:padding="10dp"
        android:singleLine="true"
        android:inputType="text" />

    <!-- Inject stage -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Inject on"
        android:textColor="#aaa"
        android:textSize="12sp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="4dp" />

    <RadioGroup
        android:id="@+id/rgInjectStage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rbFinish"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Page finish"
            android:textColor="#ccc"
            android:layout_marginEnd="20dp" />

        <RadioButton
            android:id="@+id/rbStart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Page start"
            android:textColor="#ccc" />
    </RadioGroup>

    <!-- Code editor -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="JavaScript"
        android:textColor="#aaa"
        android:textSize="12sp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etScriptCode"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:hint="// your JS here..."
        android:textColor="#ffffff"
        android:textColorHint="#444"
        android:textSize="13sp"
        android:fontFamily="monospace"
        android:background="#1a1a1e"
        android:padding="10dp"
        android:gravity="top|start"
        android:inputType="textMultiLine"
        android:scrollbars="vertical" />

</LinearLayout>

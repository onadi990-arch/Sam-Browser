<?xml version="1.0" encoding="utf-8"?>
<!--
    Root is a FrameLayout so the topBar overlays the webview.
    The bar slides via translationY — zero requestLayout, zero jank.
    WebView has paddingTop = topBar height so content starts below bar.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1a1a1e">

    <!-- WebView container — fills entire screen, has paddingTop set in code -->
    <FrameLayout
        android:id="@+id/webViewContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- History dropdown — slides down from below topBar, set top margin in code -->
    <LinearLayout
        android:id="@+id/historyDropdown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1e1e24"
        android:elevation="3dp"
        android:layout_gravity="top"
        android:visibility="gone">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#3a3a3e" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/historyRecycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="280dp"
            android:overScrollMode="never" />

    </LinearLayout>

    <!-- Find bar — floats over bottom -->
    <LinearLayout
        android:id="@+id/findBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:background="#2c2c30"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:gravity="center_vertical"
        android:visibility="gone"
        android:elevation="6dp"
        android:layout_gravity="bottom">

        <EditText
            android:id="@+id/findInput"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:background="@drawable/bg_address_bar"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="#ffffff"
            android:textColorHint="#888"
            android:hint="Find in page..."
            android:textSize="14sp"
            android:singleLine="true"
            android:imeOptions="actionSearch" />

        <TextView
            android:id="@+id/tvFindCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0/0"
            android:textColor="#888"
            android:textSize="12sp"
            android:layout_marginStart="8dp" />

        <ImageButton
            android:id="@+id/btnFindPrev"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_chevron_up"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="#cccccc"
            android:contentDescription="Previous" />

        <ImageButton
            android:id="@+id/btnFindNext"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_chevron_down"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="#cccccc"
            android:contentDescription="Next" />

        <ImageButton
            android:id="@+id/btnFindClose"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_close"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="#cccccc"
            android:contentDescription="Close" />

    </LinearLayout>

    <!--
        TOP BAR — overlays at top with elevation.
        Slides via translationY: 0 = visible, -height = hidden.
        Must be declared LAST so it draws on top of everything.
    -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#242428"
        android:elevation="8dp"
        android:layout_gravity="top">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:orientation="horizontal"
            android:paddingStart="2dp"
            android:paddingEnd="4dp"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/ic_arrow_back"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:tint="#cccccc"
                android:contentDescription="Back"
                android:alpha="0.35" />

            <ImageButton
                android:id="@+id/btnForward"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/ic_arrow_forward"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:tint="#cccccc"
                android:contentDescription="Forward"
                android:alpha="0.35"
                android:layout_marginEnd="2dp" />

            <EditText
                android:id="@+id/addressBar"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:background="@drawable/bg_address_bar"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="#ffffff"
                android:textColorHint="#888"
                android:hint="Search or URL"
                android:textSize="13sp"
                android:singleLine="true"
                android:imeOptions="actionGo"
                android:inputType="textUri"
                android:ellipsize="end" />

            <ImageButton
                android:id="@+id/btnRefresh"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/ic_refresh"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:tint="#cccccc"
                android:contentDescription="Refresh"
                android:layout_marginStart="2dp" />

            <FrameLayout
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:gravity="center">
                <TextView
                    android:id="@+id/btnTabs"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:text="1"
                    android:textColor="#cccccc"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/bg_tab_count" />
            </FrameLayout>

            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/ic_more"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Menu"
                android:tint="#cccccc" />

        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressBar"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:max="100"
            android:progressTint="#4A90E2"
            android:visibility="gone" />

    </LinearLayout>

</FrameLayout>
